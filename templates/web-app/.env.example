# Copy to .env with `python scripts/make_env.py`, which also writes the secret
# files. Never commit .env or the secrets folder.
#
# Secrets are not in this file: each is a Compose secret file in SECRETS_DIR
# (db_superuser_password, app_db_password, backup_db_password, admin_password,
# jwt_secret, smtp_password), mounted at /run/secrets only in the services that
# need it. Keep SECRETS_DIR outside the repository if you can (default ./secrets,
# which is git-ignored).
SECRETS_DIR=./secrets

# --- Database (docker-compose + backend config) ---
# The app's own role (not a superuser; docker/db-init/roles.sh). Its password is
# the secret app_db_password; the backup uses <POSTGRES_USER>_backup, read-only.
POSTGRES_USER=app
POSTGRES_DB=app
# DATABASE_URL is composed from the parts by core/config.py, so the password
# is written once. Set it explicitly only for an external or
# managed database with its own connection string; an explicit value wins.
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# --- Host ports (so several projects' stacks can run side by side) ---
# DB_PORT=5434
# BACKEND_PORT=8001
# FRONTEND_PORT=5174

# --- Auth (single admin, per standards/stacks/web-app.md) ---
ADMIN_EMAIL=admin@example.com
# The password is the secret admin_password: at least 12 characters, no placeholder.
# Template toggle: false = single-user app (no user management endpoints/UI;
# any authenticated user is treated as admin). true = multi-user: admins
# manage accounts via /api/users and the Admin page.
MULTI_USER_ENABLED=false
# The signing key is the secret jwt_secret: at least 32 random characters.
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- App ---
# production forces COOKIE_SECURE=true, DOCS_ENABLED=false and
# SEED_ENABLED=false whatever the lines below say.
ENVIRONMENT=development
# Whose calendar decides "today" for dates and weekly stats.
APP_TIMEZONE=Europe/London
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5174
# Secure cookies need HTTPS. Keep false for local http://localhost dev;
# set true when deploying behind HTTPS.
COOKIE_SECURE=false
# OpenAPI docs UI (/docs). Keep true for dev; set false in production.
DOCS_ENABLED=true
# Demo seeder (`python -m app.seed`, POST /api/admin/reseed). Opt-in, and it
# must stay false in production.
SEED_ENABLED=true
# Filesystem root for attachment uploads (Docker volume in compose).
ATTACHMENTS_DIR=/data/uploads
# Upload quotas in MB: per uploader, and for all files together.
UPLOAD_QUOTA_MB_PER_USER=500
UPLOAD_QUOTA_MB_TOTAL=10240
# Days a deleted survey stays in the recycle bin.
TRASH_RETENTION_DAYS=30

# ── Email (Help → Report or suggest) ─────────────────────────────────────────
# Any SMTP server or relay (Microsoft 365: smtp.office365.com:587, Gmail:
# smtp.gmail.com:587 with an app password, SendGrid: smtp.sendgrid.net:587
# user "apikey"). Port 465 uses implicit TLS; otherwise STARTTLS. Leave
# SMTP_HOST empty to turn email off — reports are still kept and listed
# under Admin → Feedback. WHERE reports go is set in the app, in Admin.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
# The password is the secret smtp_password (an empty file when email is off).
SMTP_FROM=
SMTP_STARTTLS=true

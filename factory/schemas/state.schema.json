{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "state",
  "version": 1,
  "title": "Project state (ideas/<slug>/state.json)",
  "type": "object",
  "required": ["schema_version", "slug", "name", "kind", "stage", "status", "factory_version", "updated", "gates", "next"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "slug": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "kind": { "enum": ["app", "factory-asset", "demo"] },
    "scope": {
      "type": "object",
      "description": "The business and brands the idea belongs to (factory/context/scopes.json). Absent, or business null: group-wide",
      "additionalProperties": false,
      "properties": {
        "business": { "type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "brands": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }, "uniqueItems": true }
      }
    },
    "owner": { "type": "string", "minLength": 1, "description": "Who develops the idea (Develop and Assess is theirs); its gate decisions are signed off by an approver other than them" },
    "parent": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$", "description": "An epic: the project or programme whose roadmap it belongs to (ideas/<parent>/roadmap.md)" },
    "epic": { "type": "string", "pattern": "^E\\d+$", "description": "An epic: its ID in the parent's roadmap" },
    "stage": { "enum": ["develop", "roadmap", "spec", "build", "publish", "done"], "description": "roadmap: a project or programme whose roadmap is approved; its epics go through the factory as ideas of their own" },
    "status": { "enum": ["in-progress", "awaiting-approval", "paused", "interrupted", "done", "stopped"] },
    "factory_version": { "type": "string" },
    "updated": { "type": "string", "format": "date" },
    "template": { "type": ["string", "null"] },
    "tier": { "enum": [1, 2, 3, 4, null] },
    "versions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "assessment": { "type": ["string", "null"] },
        "application_definition": { "type": ["string", "null"] },
        "spec": { "type": ["string", "null"] },
        "composition": { "type": ["string", "null"] }
      }
    },
    "current": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "epic": { "type": ["string", "null"] }, "story": { "type": ["string", "null"] }, "milestone": { "type": ["string", "null"] } }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^[1-4]$": {
          "type": "object",
          "required": ["status"],
          "additionalProperties": false,
          "properties": {
            "status": { "enum": ["not-reached", "awaiting-approval", "approved", "changes-requested", "get-ready", "stopped"], "description": "Gate 1 is the investment decision: approved is Go, get-ready and stopped the other two" },
            "date": { "type": "string", "format": "date" },
            "reply": { "type": "string" },
            "file": { "type": "string" },
            "version": { "type": "string" },
            "by": { "type": "string", "description": "Who signed the decision off: a gate approver for the idea's scope" },
            "note": { "type": "string", "description": "A sign-off to note, such as by the idea's owner when no one else could" }
          }
        }
      }
    },
    "blockers": { "type": "array", "items": { "type": "string" } },
    "last_verification": {
      "type": ["object", "null"],
      "required": ["date", "summary"],
      "additionalProperties": false,
      "properties": { "date": { "type": "string", "format": "date" }, "summary": { "type": "string" }, "report": { "type": "string" } }
    },
    "imports": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file", "version", "date"],
        "additionalProperties": false,
        "properties": { "file": { "type": "string" }, "version": { "type": "string" }, "date": { "type": "string", "format": "date" } }
      }
    },
    "app": {
      "type": "object",
      "required": ["repo", "url"],
      "additionalProperties": false,
      "properties": { "repo": { "type": "string" }, "url": { "type": "string", "pattern": "^https?://" } }
    },
    "changes": { "type": "array", "items": { "type": "string", "pattern": "^CR-\\d{3}$" } },
    "assessment": {
      "type": "object",
      "description": "The Gate 1 investment decision, carried from assessment.md by pipeline.py decide",
      "required": ["decision", "foundations"],
      "additionalProperties": false,
      "properties": {
        "decision": { "enum": ["go", "get-ready", "stop"] },
        "score": { "type": ["number", "null"], "description": "The RICE score; null when knocked out" },
        "period": { "type": "string" },
        "foundations": {
          "type": "object",
          "propertyNames": { "enum": ["problem", "value", "data", "risk", "people"] },
          "additionalProperties": { "enum": ["green", "amber", "red"] }
        },
        "fix": { "type": "array", "items": { "enum": ["problem", "value", "data", "risk", "people"] }, "uniqueItems": true },
        "owner": { "type": "string", "description": "Get Ready: who fixes the foundations" },
        "review": { "type": "string", "format": "date", "description": "Get Ready: when it comes back to Gate 1" }
      }
    },
    "route": { "enum": ["full", "light", "roadmap"], "description": "Absent is full (tier 2, 3 or 4). The roadmap route (a project or programme) approves its build-out over time; each epic is an idea of its own. The light route (a spike, tier 1) skips the spec pack and Gate 2 (its plan, plan.md, is approved at Gate 1) and ends at Gate 3 with grow, keep or stop" },
    "light": {
      "type": "object",
      "description": "How the light route ended at Gate 3 (pipeline.py light)",
      "required": ["result", "date", "reply"],
      "additionalProperties": false,
      "properties": {
        "result": { "enum": ["grow", "keep", "stop"] },
        "to_tier": { "enum": [2, 3, 4], "description": "Grow: the tier it grew to" },
        "date": { "type": "string", "format": "date" },
        "reply": { "type": "string" },
        "by": { "type": "string" },
        "note": { "type": "string" }
      }
    },
    "next": { "type": "string" }
  }
}

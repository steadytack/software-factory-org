{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "catalogue-entry",
  "version": 1,
  "title": "Catalogue entry (catalogue/assets/CAT-nnn.json). Unknown values are the string 'unknown', never guessed. Build assets are validated and approved; reference cards (system, process, policy) point at a source of truth (source.ref is its URL) and are confirmed by their maintainer.",
  "type": "object",
  "required": ["schema_version", "id", "name", "purpose", "type", "tags", "version", "status", "source", "licence", "dependencies", "interfaces", "evidence", "risks", "limitations", "history"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^CAT-\\d{3}$" },
    "name": { "type": "string", "minLength": 1 },
    "purpose": { "type": "string", "minLength": 1 },
    "type": { "enum": ["template", "module", "design", "technical", "integration", "operational", "ai", "specification", "recipe", "reference", "lesson", "brand-kit", "system", "process", "policy"] },
    "tags": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }, "uniqueItems": true },
    "version": { "type": "string" },
    "status": { "enum": ["imported", "assessed", "validated", "approved", "rejected", "needs-changes", "deprecated", "archived", "draft", "confirmed", "retired"] },
    "scope": { "type": "string", "pattern": "^(group|business:[a-z0-9][a-z0-9-]*|brand:[a-z0-9][a-z0-9-]*)$", "description": "Who the entry belongs to (factory/context/scopes.json). Absent: group, the whole factory" },
    "source": {
      "type": "object",
      "required": ["ref"],
      "additionalProperties": false,
      "properties": {
        "ref": { "type": "string", "description": "A path in this repository (templates/...), or a source record id (SRC-nnn)" },
        "path": { "type": "string", "description": "Where the asset sits inside the source" },
        "revision": { "type": "string" },
        "checksum": { "type": "string" }
      }
    },
    "runtime": { "enum": ["python", "node", "web", "python+node", "go", "rust", "cpp", "java", "docker", "none", "unknown"] },
    "licence": { "type": "string" },
    "maintainer": { "type": "string", "description": "The named person or team who owns the entry" },
    "last_reviewed": { "type": "string", "format": "date", "description": "Reference cards: when the maintainer last confirmed the card" },
    "review_by": { "type": "string", "format": "date", "description": "Reference cards: the card is stale after this date" },
    "dependencies": { "type": "array", "items": { "type": "string" } },
    "compatibility": { "type": "array", "items": { "type": "string" } },
    "interfaces": { "type": "array", "items": { "type": "string" } },
    "parent": { "type": "string", "pattern": "^CAT-\\d{3}$", "description": "The template a module belongs to" },
    "related": { "type": "array", "items": { "type": "string", "pattern": "^CAT-\\d{3}$" } },
    "usage": { "type": "string" },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date", "check", "result"],
        "additionalProperties": false,
        "properties": {
          "date": { "type": "string", "format": "date" },
          "check": { "type": "string" },
          "result": { "enum": ["passed", "failed", "not-run", "partial"] },
          "detail": { "type": "string" }
        }
      }
    },
    "risks": { "type": "array", "items": { "type": "string" } },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["date", "status", "by"],
        "additionalProperties": false,
        "properties": {
          "date": { "type": "string", "format": "date" },
          "status": { "enum": ["imported", "assessed", "validated", "approved", "rejected", "needs-changes", "deprecated", "archived", "draft", "confirmed", "retired"] },
          "by": { "type": "string" },
          "note": { "type": "string" }
        }
      }
    },
    "replaced_by": { "type": "string", "pattern": "^CAT-\\d{3}$" }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "enum": ["system", "process", "policy"] } }, "required": ["type"] },
      "then": { "required": ["maintainer"], "properties": { "status": { "enum": ["draft", "confirmed", "retired"] } } },
      "else": { "properties": { "status": { "not": { "enum": ["draft", "confirmed", "retired"] } } } }
    },
    {
      "if": { "properties": { "status": { "const": "confirmed" } }, "required": ["status"] },
      "then": { "required": ["last_reviewed", "review_by"] }
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "triage",
  "version": 1,
  "title": "Triage register (ideas/triage.json): every idea fed in, its knock-out or RICE score, and the Gate 0 pick",
  "type": "object",
  "required": ["schema_version", "period", "entries"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "scope": { "type": "string", "description": "Default scope for entries: group, business:<b> or brand:<x>. Absent: group" },
    "period": { "type": "string", "minLength": 1, "description": "The period Reach is counted over, for every entry (per month, per quarter...)" },
    "updated": { "type": "string", "format": "date" },
    "entries": { "type": "array", "items": { "$ref": "#/$defs/entry" } }
  },
  "$defs": {
    "reasoned_number": {
      "type": "object",
      "required": ["value", "reason"],
      "additionalProperties": false,
      "properties": { "value": { "type": "number" }, "reason": { "type": "string", "minLength": 1 } }
    },
    "entry": {
      "type": "object",
      "required": ["id", "title", "idea", "source", "added", "status"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^TRI-\\d{3}$" },
        "title": { "type": "string", "minLength": 1 },
        "idea": { "type": "string", "minLength": 1, "description": "The idea as given (the inbox line, or the single idea)" },
        "source": { "enum": ["inbox", "single"] },
        "added": { "type": "string", "format": "date" },
        "scope": { "type": "string" },
        "status": {
          "enum": ["new", "scored", "knocked-out", "parked", "picked"],
          "description": "new: not yet assessed; scored: survived the knock-outs and has RICE; knocked-out; parked: the owner chose not now; picked: Gate 0 approved, scaffolded as an idea"
        },
        "data_classes": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "template": { "type": "string", "description": "The likely template (or none), which informs Effort" },
        "assets": { "type": "array", "items": { "type": "string", "pattern": "^CAT-\\d{3}$" }, "uniqueItems": true },
        "knockout": {
          "type": "object",
          "required": ["rule", "reason"],
          "additionalProperties": false,
          "properties": {
            "rule": { "enum": ["data-class", "policy", "paid-service", "duplicate"] },
            "ref": { "type": "string", "description": "POL-nn, DEF-11, ideas/<slug>, CAT-nnn or TRI-nnn" },
            "reason": { "type": "string", "minLength": 1 }
          }
        },
        "rice": {
          "type": "object",
          "required": ["reach", "impact", "confidence", "effort"],
          "additionalProperties": false,
          "properties": {
            "reach": { "$ref": "#/$defs/reasoned_number" },
            "impact": { "$ref": "#/$defs/reasoned_number" },
            "confidence": { "$ref": "#/$defs/reasoned_number" },
            "effort": { "$ref": "#/$defs/reasoned_number" }
          }
        },
        "parked": {
          "type": "object",
          "required": ["date", "reason"],
          "additionalProperties": false,
          "properties": { "date": { "type": "string", "format": "date" }, "reason": { "type": "string", "minLength": 1 } }
        },
        "picked": {
          "type": "object",
          "required": ["date", "slug", "reply"],
          "additionalProperties": false,
          "properties": {
            "date": { "type": "string", "format": "date" },
            "slug": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
            "reply": { "type": "string" }
          }
        }
      }
    }
  }
}

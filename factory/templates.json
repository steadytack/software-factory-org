{
  "version": 3,
  "note": "The one list of templates. The template tables in README.md and factory/dormant/spec.md are generated from it (python factory/scripts/check_factory.py --fix). Each ready template is also an approved catalogue entry (catalogue/assets/). 'verify' is a list of parts that factory/scripts/verify.py runs in clean containers (cwd is relative to the template folder; services are sidecar containers on a private network, reachable by their name). 'deployment' and 'interfaces' use the categories of the Application Definition.",
  "templates": [
    {
      "name": "web-app",
      "status": "ready",
      "order": 6,
      "version": "1.4.0",
      "runtime": "python+node",
      "readme_status": "ready, verified (see its README)",
      "readme_for": "a web application with a frontend and backend, geospatial-capable",
      "fits": "Login, stored records, files, several screens, roles, offline or a map",
      "weak_at": "small ideas (heavy: database, backups, auth); sample sites/surveys code must be removed",
      "stack": "web-app",
      "workflow": "web-app",
      "verify": [
        {
          "name": "backend",
          "runtime": "python",
          "image": "python:3.12-slim",
          "cwd": "backend",
          "env": {
            "DATABASE_URL": "postgresql+asyncpg://app:verify@db:5432/app_test",
            "TEST_DATABASE_URL": "postgresql+asyncpg://app:verify@db:5432/app_test",
            "MULTI_USER_ENABLED": "true",
            "ADMIN_EMAIL": "admin@example.com",
            "ADMIN_PASSWORD": "Verify-Admin-Pass-2026!!",
            "JWT_SECRET": "verify-secret-verify-secret-verify-secret-123"
          },
          "services": [
            {
              "name": "db",
              "image": "postgis/postgis:17-3.5",
              "env": {
                "POSTGRES_USER": "app",
                "POSTGRES_PASSWORD": "verify",
                "POSTGRES_DB": "app_test"
              },
              "ready": "pg_isready -U app -d app_test"
            }
          ],
          "setup": [
            "pip install -q -r requirements-dev.txt",
            "pip install -q 'poetry>=2,<3'"
          ],
          "steps": [
            "poetry check --lock",
            "ruff check app tests migrations",
          "PYTHONPATH=. lint-imports",
            "python -m pytest -q"
          ]
        },
        {
          "name": "frontend",
          "runtime": "node",
          "image": "node:24",
          "cwd": "frontend",
          "setup": [
            "npm ci"
          ],
          "steps": [
            "npx tsc --noEmit -p .",
            "npx eslint src tests --quiet",
            "npx vitest run"
          ]
        }
      ],
      "ports": [
        "DB_PORT",
        "BACKEND_PORT",
        "FRONTEND_PORT"
      ],
      "compose_project": "web-app-template",
      "modules": [],
      "options": [
        {
          "id": "share",
          "kind": "feature",
          "label": "Share button in the header (share sheet, copy link, email link)",
          "default": true,
          "files": [
            "frontend/src/components/ShareButton.tsx",
            "frontend/tests/share-button.test.tsx"
          ]
        },
        {
          "id": "theme",
          "kind": "feature",
          "label": "Theme changer in the header (light, dark, system); off follows the device",
          "default": true,
          "files": [
            "frontend/src/components/ThemeToggle.tsx"
          ]
        },
        {
          "id": "help.guides",
          "kind": "feature",
          "label": "Help > Guides: markdown guides, one collapsible section per heading, chosen by page",
          "default": true,
          "files": [
            "frontend/src/help/guides",
            "frontend/src/help/guides.ts",
            "frontend/src/help/types.ts",
            "frontend/tests/help-guides.test.tsx"
          ]
        },
        {
          "id": "help.feedback",
          "kind": "feature",
          "label": "Help > Feedback: Problem, Suggestion and Question reports, with an optional screenshot",
          "default": true,
          "files": [
            "frontend/src/help/FeedbackForm.tsx",
            "frontend/src/components/FeedbackAdminPanel.tsx",
            "frontend/src/lib/screenshot.ts",
            "frontend/src/lib/diagnostics.ts",
            "frontend/src/lib/errorLog.ts",
            "frontend/tests/feedback.test.tsx",
            "backend/app/api/endpoints/feedback.py",
            "backend/app/services/feedback.py",
            "backend/tests/test_feedback.py"
          ]
        },
        {
          "id": "help",
          "kind": "group",
          "label": "Help button in the header (on while Guides or Feedback is on)",
          "on_if_any": [
            "help.guides",
            "help.feedback"
          ],
          "files": [
            "frontend/src/help"
          ]
        },
        {
          "id": "feedback.problem",
          "kind": "route",
          "label": "Where Problem reports go: email:<address>, email: (the admin's address), store (kept in the app only) or off",
          "default": "email:",
          "env": "FEEDBACK_PROBLEM",
          "needs": "help.feedback"
        },
        {
          "id": "feedback.suggestion",
          "kind": "route",
          "label": "Where Suggestions go: email:<address>, email:, store or off",
          "default": "email:",
          "env": "FEEDBACK_SUGGESTION",
          "needs": "help.feedback"
        },
        {
          "id": "feedback.question",
          "kind": "route",
          "label": "Where Questions go: email:<address>, email:, store or off",
          "default": "email:",
          "env": "FEEDBACK_QUESTION",
          "needs": "help.feedback"
        },
        {
          "id": "heartbeat",
          "kind": "feature",
          "label": "Heartbeat: the scheduler pings a dead-man's-switch URL (HEARTBEAT_URL; healthchecks.io, Uptime Kuma push) while /api/health answers 200, so you are alerted when the app is down where nothing outside can reach it",
          "default": true,
          "files": [
            "backend/app/heartbeat.py",
            "backend/tests/test_heartbeat.py"
          ]
        }
      ],
      "deployment": [
        "local",
        "hosted"
      ],
      "interfaces": [
        "web",
        "mobile",
        "specialist-visual"
      ]
    }
  ],
  "gaps": []
}
